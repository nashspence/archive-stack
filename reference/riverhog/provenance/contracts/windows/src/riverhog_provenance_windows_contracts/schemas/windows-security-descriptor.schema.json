{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nashspence.github.io/riverhog/v1/provenance/observers/schemas/windows-security-descriptor.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "security_information",
    "control",
    "owner_sid",
    "group_sid",
    "sacl_included"
  ],
  "properties": {
    "security_information": {
      "type": "integer",
      "minimum": 0
    },
    "control": {
      "type": "integer",
      "minimum": 0
    },
    "owner_sid": {
      "type": "string",
      "pattern": "^(?:|S-[0-9-]+)$"
    },
    "group_sid": {
      "type": "string",
      "pattern": "^(?:|S-[0-9-]+)$"
    },
    "sacl_included": {
      "type": "boolean"
    }
  }
}
