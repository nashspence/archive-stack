JEB_ACCOUNTS=example-camera,example-phone
JEB_FTP_ACCOUNTS=example-camera
JEB_TUS_ACCOUNTS=example-camera,example-phone
JEB_ACCOUNT_EXAMPLE_CAMERA_PASSWORD=example-camera-password
JEB_ACCOUNT_EXAMPLE_PHONE_PASSWORD=example-phone-password
JEB_LANDING_DIR=/landing
JEB_STATE_DIR=/state
JEB_TUS_STAGING_DIR=/landing/.ingress/tus
JEB_FTP_PUBLIC_HOST=127.0.0.1
JEB_MUNCHY_URL=http://munchy-runner:8080

JEB_CADENCE=weekly
JEB_WEEKDAY=monday
JEB_HOUR=3
JEB_MINUTE=0
JEB_STABLE_AGE=10m
JEB_INCLUDE_EXTENSIONS=.mp4,.mov,.mkv,.webm,.xml,.json,.txt
# Optional per-account override. Supported: weekly, monthly, seasonal, manual.
JEB_ACCOUNT_EXAMPLE_PHONE_CADENCE=seasonal

JEB_CLEANUP=after_target_success
JEB_OUTPUT_MODE=video
JEB_ARCHIVE_TASKS=archive_video
JEB_RIVERHOG_WAIT=finalized
JEB_RIVERHOG_RETAIN_HOT=true
