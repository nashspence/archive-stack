{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nashspence.github.io/riverhog/v1/schemas/riverhog-provenance-bindings-v1.schema.json",
  "title": "Riverhog v1 bounded provenance file bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "first_file_order", "files"],
  "properties": {
    "schema": {"const": "riverhog-provenance-bindings/v1"},
    "first_file_order": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["captured", "omitted"]},
        "journal_id": {"type": "string"},
        "current_state_id": {"type": "string"},
        "omission_reason": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {
          "properties": {"status": {"const": "captured"}},
          "required": ["journal_id", "current_state_id"],
          "not": {"required": ["omission_reason"]}
        },
        {
          "properties": {"status": {"const": "omitted"}},
          "required": ["omission_reason"],
          "not": {"anyOf": [{"required": ["journal_id"]}, {"required": ["current_state_id"]}]}
        }
      ]
    }
  }
}
