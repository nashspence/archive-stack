{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nashspence.github.io/riverhog/v1/schemas/riverhog-provenance-root-v1.schema.json",
  "title": "Riverhog v1 immutable provenance root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "archive_generation", "archive_tree_sha256", "volume_sequence"],
  "properties": {
    "schema": {"const": "riverhog-provenance-root/v1"},
    "archive_generation": {"$ref": "#/$defs/sha256"},
    "archive_tree_sha256": {"$ref": "#/$defs/sha256"},
    "volume_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
