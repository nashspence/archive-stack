{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nashspence.github.io/riverhog/v1/schemas/collection-archive-volume-v1.schema.json",
  "$comment": "This schema is the structural projection. riverhog_archive_contracts.CollectionArchiveVolumeDocument is the canonical semantic, identity, and canonical-JSON authority.",
  "title": "Riverhog v1 bounded immutable archive-volume metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "archive_generation", "archive_tree_sha256", "volume"],
  "properties": {
    "schema": {"const": "collection-archive-volume/v1"},
    "archive_generation": {"$ref": "#/$defs/sha256"},
    "archive_tree_sha256": {"$ref": "#/$defs/sha256"},
    "volume": {"oneOf": [{"$ref": "#/$defs/pack"}, {"$ref": "#/$defs/segment"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sequence": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "age_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "header_b64", "payload_nonce_b64", "plaintext_size"],
      "properties": {
        "format": {"const": "age-v1-scrypt-resumable"},
        "header_b64": {"type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}|[A-Za-z0-9+/]{3})$"},
        "payload_nonce_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{21}[AQgw]$"},
        "plaintext_size": {"type": "integer", "minimum": 0}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "plaintext_start", "plaintext_bytes", "plaintext_sha256", "stored_bytes", "stored_sha256"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "plaintext_start": {"type": "integer", "minimum": 0},
        "plaintext_bytes": {"type": "integer", "minimum": 0},
        "plaintext_sha256": {"$ref": "#/$defs/sha256"},
        "stored_bytes": {"type": "integer", "minimum": 1},
        "stored_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "kind", "path", "files", "source_bytes", "plaintext_bytes", "age_state", "index_sha256", "plan_sha256", "parts"],
      "properties": {
        "id": {"type": "string", "pattern": "^pack-[0-9a-f]{64}$"},
        "sequence": {"$ref": "#/$defs/sequence"},
        "kind": {"const": "pack"},
        "path": {"type": "string", "pattern": "^volumes/pack-[0-9a-f]{64}\\.tar\\.age$"},
        "files": {"type": "integer", "minimum": 1, "maximum": 50000},
        "source_bytes": {"type": "integer", "minimum": 0},
        "plaintext_bytes": {"type": "integer", "minimum": 0},
        "age_state": {"$ref": "#/$defs/age_state"},
        "index_sha256": {"$ref": "#/$defs/sha256"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "parts": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/part"}}
      }
    },
    "segment_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "offset", "bytes", "file_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!\\.riverhog/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"},
        "offset": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "file_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "kind", "path", "plaintext_bytes", "age_state", "file", "parts"],
      "properties": {
        "id": {"type": "string", "pattern": "^segment-[0-9a-f]{64}$"},
        "sequence": {"$ref": "#/$defs/sequence"},
        "kind": {"const": "segment"},
        "path": {"type": "string", "pattern": "^volumes/segment-[0-9a-f]{64}\\.bin\\.age$"},
        "plaintext_bytes": {"type": "integer", "minimum": 0},
        "age_state": {"$ref": "#/$defs/age_state"},
        "file": {"$ref": "#/$defs/segment_file"},
        "parts": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/part"}}
      }
    }
  }
}
