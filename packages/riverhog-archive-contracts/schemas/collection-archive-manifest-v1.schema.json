{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nashspence.github.io/riverhog/v1/schemas/collection-archive-manifest-v1.schema.json",
  "$comment": "This schema is the structural projection. riverhog_archive_contracts.CollectionArchiveManifest is the canonical semantic, identity, and canonical-JSON authority.",
  "title": "Riverhog v1 immutable collection archive root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "archive_generation", "format", "tree", "volume_sequence"],
  "properties": {
    "schema": {"const": "collection-archive-manifest/v1"},
    "archive_generation": {"$ref": "#/$defs/sha256"},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encryption", "pack_index", "part_digest", "selective_read"],
      "properties": {
        "encryption": {"const": "age-v1-scrypt"},
        "pack_index": {"const": "riverhog-pack-index/v1"},
        "part_digest": {"const": "sha256"},
        "selective_read": {"const": "age-chunk-range/v1"}
      }
    },
    "tree": {"$ref": "#/$defs/tree"},
    "volume_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "bytes", "sha256"],
      "properties": {
        "files": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "plaintext_bytes", "sha256", "stored_bytes", "stored_sha256"],
      "properties": {
        "id": {"const": "provenance-root"},
        "kind": {"const": "provenance-root"},
        "path": {"const": "provenance/root.json.age"},
        "plaintext_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "stored_bytes": {"type": "integer", "minimum": 1},
        "stored_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "root"],
      "properties": {
        "identity": {"$ref": "#/$defs/sha256"},
        "root": {"$ref": "#/$defs/provenance_root"}
      }
    }
  }
}
