{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nashspence.github.io/riverhog/v1/provenance/observers/schemas/windows-object-id.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "extended_info"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "extended_info": {
      "type": "string",
      "pattern": "^[0-9a-f]{0,96}$"
    }
  }
}
