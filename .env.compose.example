# Copy this file to .env.compose to override defaults locally.
COMPOSE_PROJECT_NAME=riverhog
# Optional: use a separate Compose project for local test stack experiments.
# TEST_COMPOSE_PROJECT_NAME=riverhog-test

RIVERHOG_API_PORT=8000
RIVERHOG_WEBDAV_PORT=8080

RIVERHOG_OBJECT_STORE=s3
RIVERHOG_LOG_LEVEL=INFO
RIVERHOG_S3_ENDPOINT_URL=http://garage:3900
RIVERHOG_S3_REGION=garage
RIVERHOG_S3_BUCKET=riverhog
RIVERHOG_S3_ACCESS_KEY_ID=GK000000000000000000000001
RIVERHOG_S3_SECRET_ACCESS_KEY=1111111111111111111111111111111111111111111111111111111111111111
RIVERHOG_S3_FORCE_PATH_STYLE=true
RIVERHOG_GLACIER_ENDPOINT_URL=http://garage:3900
RIVERHOG_GLACIER_REGION=garage
RIVERHOG_GLACIER_BUCKET=riverhog-archive
RIVERHOG_GLACIER_ACCESS_KEY_ID=GK000000000000000000000002
RIVERHOG_GLACIER_SECRET_ACCESS_KEY=2222222222222222222222222222222222222222222222222222222222222222
RIVERHOG_GLACIER_FORCE_PATH_STYLE=true
RIVERHOG_GLACIER_PREFIX=glacier
RIVERHOG_GLACIER_BACKEND=s3
RIVERHOG_GLACIER_STORAGE_CLASS=DEEP_ARCHIVE
RIVERHOG_GLACIER_ARCHIVE_ENCRYPTION=age_scrypt
RIVERHOG_GLACIER_ARCHIVE_REQUIRE_EXPLICIT_PASSPHRASE=false
RIVERHOG_GLACIER_ARCHIVE_PASSPHRASE=
RIVERHOG_GLACIER_ARCHIVE_WORK_FACTOR=18
RIVERHOG_GLACIER_UPLOAD_RETRY_DELAY=5m
RIVERHOG_GLACIER_UPLOAD_SWEEP_INTERVAL=30s
RIVERHOG_OPERATOR_WEBHOOK_URL=
RIVERHOG_OPERATOR_WEBHOOK_TIMEOUT=5s
RIVERHOG_OPERATOR_WEBHOOK_RETRY_DELAY=60s
RIVERHOG_OPERATOR_WEBHOOK_REMINDER_INTERVAL=1h
RIVERHOG_OPERATOR_FAILURE_NOTIFICATION_INTERVAL=24h
RIVERHOG_GLACIER_RECOVERY_SWEEP_INTERVAL=30s
RIVERHOG_GLACIER_RECOVERY_RESTORE_LATENCY=48h
RIVERHOG_GLACIER_RECOVERY_READY_TTL=24h
RIVERHOG_OTS_STAMP_COMMAND=ots
RIVERHOG_OTS_VERIFY_COMMAND=ots
RIVERHOG_RECOVERY_PAYLOAD_COMMAND=age
RIVERHOG_RECOVERY_PAYLOAD_REQUIRE_EXPLICIT_PASSPHRASE=false
RIVERHOG_RECOVERY_PAYLOAD_PASSPHRASE=riverhog-dev-recovery-passphrase
RIVERHOG_RECOVERY_PAYLOAD_WORK_FACTOR=12
RIVERHOG_RECOVERY_PAYLOAD_MAX_WORK_FACTOR=30
RIVERHOG_PLANNER_DISC_TARGET_BYTES=50GB
RIVERHOG_PLANNER_MIN_FILL_RATIO=99%
RIVERHOG_PLANNER_MIN_FILL_BYTES=
RIVERHOG_PLANNER_UNPLANNED_SATURATION_BYTES=300GB
RIVERHOG_PLANNER_IMAGE_ROOT=/app/.riverhog/images
RIVERHOG_UNBURNED_COLLECTION_BYTES_LIMIT=500GB
RIVERHOG_TUSD_BASE_URL=http://tusd:1080/files
RIVERHOG_TUSD_PUBLIC_BASE_URL=
RIVERHOG_TUSD_HOOK_SECRET=dev-tusd-hook-secret
RIVERHOG_WEBDAV_ENABLED=true
RIVERHOG_WEBDAV_ADDR=0.0.0.0:8080

POSTGRES_DB=riverhog
POSTGRES_USER=riverhog
POSTGRES_PASSWORD=riverhog
RIVERHOG_DATABASE_URL=postgresql+psycopg://riverhog:riverhog@postgres:5432/riverhog
RIVERHOG_PUBLIC_BASE_URL=http://app:8000

INCOMPLETE_UPLOAD_TTL=24h
UPLOAD_EXPIRY_SWEEP_INTERVAL=30s
