      },
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Munchy archive output is complete and heading to archival storage."
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "notification"
      ],
      "optional_payload_fields": [
        "collection_slug",
        "collection_timestamp",
        "recipient",
        "message",
        "severity"
      ]
    },
    {
      "event": "job.issue",
      "category": "munchy_job",
      "source": "services.munchy-runner",
      "purpose": "Munchy encountered an operator-visible issue, such as a local preflight failure or a retrying handoff.",
      "operator_urgency": "time_sensitive",
      "operator_action": "inspect Munchy job details when convenient",
      "delivery": {
        "mode": "paced_best_effort",
        "retry": false,
        "reminder": true,
        "reminder_interval_env": "MUNCHY_RUNNER_NOTIFY_ISSUE_REPEAT_SECONDS"
      },
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Needs attention: {error_120}"
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "severity",
        "message",
        "notification"
      ],
      "optional_payload_fields": [
        "collection_slug",
        "collection_timestamp",
        "recipient",
        "component",
        "error",
        "device_id",
        "workflow_mode",
        "failed_file_count"
      ]
    },
    {
      "event": "job.succeeded",
      "category": "munchy_job",
      "source": "services.munchy-runner",
      "purpose": "Munchy completed a job successfully.",
      "operator_urgency": "time_sensitive",
      "operator_action": "none",
      "delivery": {
        "mode": "best_effort",
        "retry": false,
