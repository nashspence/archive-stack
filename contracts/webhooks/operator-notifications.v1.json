      "event": "job.issue",
      "category": "munchy_job",
      "source": "services.munchy-runner",
      "purpose": "Munchy encountered an operator-visible issue, such as a local preflight failure or a retrying handoff.",
      "operator_urgency": "time_sensitive",
      "operator_action": "inspect Munchy job details when convenient",
      "delivery": {
        "mode": "paced_best_effort",
        "retry": false,
        "reminder": true,
        "reminder_interval_env": "RIVERHOG_OPERATOR_WEBHOOK_REMINDER_INTERVAL",
