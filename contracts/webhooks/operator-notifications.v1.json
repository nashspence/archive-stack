        "session_id",
        "delivered_at",
        "images",
        "collections",
        "restore_expires_at",
        "reminder_count",
        "reminder_interval_seconds",
        "operator_urgency",
        "operator_action",
        "operator_message"
      ],
      "optional_payload_fields": [
        "session_url"
      ],
      "type_values": [
