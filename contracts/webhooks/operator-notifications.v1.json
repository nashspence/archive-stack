      "canonical_notification": {
        "actor": "riverhog",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Oink, archive finalizing hit a retryable issue: {error_80}. Next retry: {next_retry_at}; no action yet."
      },
      "required_payload_fields": [
        "event",
        "type",
        "collection_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "attempts",
        "failed_at",
        "next_retry_at",
        "retry_delay_seconds",
        "error"
      ],
      "optional_payload_fields": [
        "collection_url",
        "upload_url"
      ]
    },
    {
