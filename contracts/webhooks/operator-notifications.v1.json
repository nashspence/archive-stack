    {
      "event": "collections.archive_retrying",
      "category": "collection_lifecycle",
      "source": "riverhog_core.services.glacier_uploads",
      "purpose": "Glacier archive upload encountered a recoverable failure and Riverhog will keep retrying.",
      "operator_urgency": "time_sensitive",
      "operator_action": "wait unless failures persist beyond normal connectivity trouble",
      "delivery": {
        "mode": "paced_best_effort",
        "retry": false,
        "reminder": true,
        "reminder_interval_env": "RIVERHOG_OPERATOR_FAILURE_NOTIFICATION_INTERVAL"
