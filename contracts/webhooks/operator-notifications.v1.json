{
  "schema_version": 1,
  "surface": "riverhog.operator_webhook",
  "description": "Machine-readable contract for Riverhog operator-facing webhook notifications.",
  "endpoint_config": {
    "url_env": "RIVERHOG_OPERATOR_WEBHOOK_URL",
    "timeout_env": "RIVERHOG_OPERATOR_WEBHOOK_TIMEOUT",
    "retry_delay_env": "RIVERHOG_OPERATOR_WEBHOOK_RETRY_DELAY",
    "reminder_interval_env": "RIVERHOG_OPERATOR_WEBHOOK_REMINDER_INTERVAL",
    "failure_notification_interval_env": "RIVERHOG_OPERATOR_FAILURE_NOTIFICATION_INTERVAL",
    "public_base_url_env": "RIVERHOG_PUBLIC_BASE_URL"
  },
  "receiver_rendering": {
    "title": "payload.notification.title",
    "message": "payload.notification.body",
    "notes": "Riverhog renders the canonical_notification template for each event into payload.notification. Receivers may use those strings directly, or render their own presentation from the same machine-readable event data.",
    "subject_max_chars": 40,
    "body_max_chars": 150,
    "title_template_tokens": [
      "emoji",
      "subject_40"
    ],
    "body_template_tokens": [
      "subject",
      "subject_40",
      "any required_payload_fields or optional_payload_fields rendered as strings",
      "field_40",
      "field_80",
      "field_120"
    ],
    "actors": {
      "riverhog": "🐷",
      "djdan": "👨🏻‍🎤",
      "munchy": "🤤"
    },
    "interruption_level_template": "critical when operator_urgency is critical; otherwise time-sensitive"
  },
  "common_payload_fields": {
    "event": "string event id matching one event below",
    "delivered_at": "UTC ISO-8601 timestamp with Z suffix",
    "notification": {
      "title": "canonical title rendered from this contract",
      "body": "canonical body rendered from this contract"
    }
  },
  "urgency_levels": {
    "passive": "Informational and does not imply immediate operator action.",
    "time_sensitive": "Useful to surface promptly; safe archived data is not implied lost.",
    "critical": "Unrecoverable or operator-blocking error that should bypass normal quieting."
  },
  "events": [
    {
      "event": "job.received",
      "category": "munchy_job",
      "source": "services.munchy-runner",
      "purpose": "Munchy accepted an ingest or conversion job.",
      "operator_urgency": "passive",
      "operator_action": "none",
      "delivery": {
        "mode": "best_effort",
        "retry": false,
        "reminder": false
      },
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Munchy received this job and queued the work."
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "notification"
      ],
      "optional_payload_fields": [
        "collection_slug",
        "collection_timestamp",
        "recipient",
        "message",
        "severity"
      ]
    },
    {
      "event": "review.handoff",
      "category": "munchy_job",
      "source": "services.munchy-runner",
      "purpose": "Munchy completed review output and is handing it to the configured review destination.",
      "operator_urgency": "time_sensitive",
      "operator_action": "none",
      "delivery": {
        "mode": "best_effort",
        "retry": false,
        "reminder": false
      },
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Munchy review output is ready and heading to the review destination."
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "notification"
      ],
      "optional_payload_fields": [
        "collection_slug",
        "collection_timestamp",
        "recipient",
        "message",
        "severity"
      ]
    },
    {
      "event": "archive.handoff",
      "category": "munchy_job",
      "source": "services.munchy-runner",
      "purpose": "Munchy completed archive encodes and is handing them off to archival storage.",
      "operator_urgency": "time_sensitive",
      "operator_action": "none",
      "delivery": {
        "mode": "best_effort",
        "retry": false,
