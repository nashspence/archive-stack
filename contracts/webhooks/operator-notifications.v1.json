      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "notification"
      ],
      "optional_payload_fields": [
        "collection_slug",
        "collection_timestamp",
        "recipient",
        "message",
        "severity"
      ]
    },
    {
      "event": "collections.upload_staged",
