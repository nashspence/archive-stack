      "operator_urgency": "time_sensitive",
      "operator_action": "resume upload or cancel the Munchy job",
      "reminder_of": "job.received",
      "delivery": {
        "mode": "paced_best_effort",
        "retry": false,
        "reminder": true,
        "reminder_interval_env": "RIVERHOG_OPERATOR_WEBHOOK_REMINDER_INTERVAL",
        "reminder_time_env": "RIVERHOG_OPERATOR_WEBHOOK_REMINDER_TIME",
