{
  "schema_version": 1,
  "surface": "riverhog.operator_webhook",
  "payload": {
    "required_fields": [
      "event",
      "delivered_at",
      "notification"
    ],
    "notification_required_fields": [
      "title",
      "body"
    ],
    "operator_urgency_values": [
      "passive",
      "time_sensitive",
      "critical"
    ]
  },
  "receiver_rendering": {
    "title_max_chars": 48,
    "subject_max_chars": 40,
    "body_max_chars": 150,
    "actors": {
      "riverhog": "🐷",
      "munchy": "🤤",
      "jeb": "🤖"
    }
  },
  "events": [
    {
      "event": "job.received",
      "operator_urgency": "passive",
      "operator_action": "none",
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Munchy received this job and queued the work."
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "notification"
      ]
    },
    {
      "event": "review.handoff",
      "operator_urgency": "time_sensitive",
      "operator_action": "none",
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Munchy review output is ready and heading to the review destination."
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "notification"
      ]
    },
    {
      "event": "archive.handoff",
      "operator_urgency": "time_sensitive",
      "operator_action": "none",
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Munchy collection archive is complete and heading to Riverhog."
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "notification"
      ]
    },
    {
      "event": "collection_archive.handoff",
      "operator_urgency": "time_sensitive",
      "operator_action": "none",
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Munchy collection archive is ready and heading to the configured target."
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "notification"
      ]
    },
    {
      "event": "job.issue",
      "operator_urgency": "time_sensitive",
      "operator_action": "inspect Munchy job details when convenient",
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "{error_120}"
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "severity",
        "message",
        "notification"
      ]
    },
    {
      "event": "job.upload_waiting.reminder",
      "operator_urgency": "time_sensitive",
      "operator_action": "resume upload or cancel the Munchy job",
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "{message_120}"
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "severity",
        "message",
        "notification",
        "upload_progress",
        "reminder_count",
        "reminder_interval_seconds"
      ]
    },
    {
      "event": "job.succeeded",
      "operator_urgency": "time_sensitive",
      "operator_action": "none",
      "canonical_notification": {
        "actor": "munchy",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Munchy finished this job successfully."
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "job_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "phase",
        "notification"
      ]
    },
    {
      "event": "jeb.issue",
      "operator_urgency": "time_sensitive",
      "operator_action": "inspect Jeb issue details",
      "operator_action_by_component": {
        "routing": "fix Munchy routing, then run Jeb archive-now for the source",
        "munchy_preflight": "repair Munchy routing preflight, then run Jeb archive-now for the source"
      },
      "canonical_notification": {
        "actor": "jeb",
        "title_template": "{emoji} {subject_40}",
        "body_template": "{notification_summary_120}"
      },
      "required_payload_fields": [
        "event",
        "type",
        "source",
        "actor",
        "source_id",
        "target_name",
        "target_type",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "severity",
        "message",
        "notification"
      ]
    },
    {
      "event": "collections.upload_staged",
      "operator_urgency": "time_sensitive",
      "operator_action": "none",
      "canonical_notification": {
        "actor": "riverhog",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Oink oink, this upload is safely staged; archiving is underway."
      },
      "required_payload_fields": [
        "event",
        "type",
        "collection_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "state",
        "files_total",
        "files_uploaded",
        "bytes_total",
        "uploaded_bytes"
      ]
    },
    {
      "event": "collections.finalized",
      "operator_urgency": "time_sensitive",
      "operator_action": "none",
      "canonical_notification": {
        "actor": "riverhog",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Oink, archive complete! This collection is safely archived and ready."
      },
      "required_payload_fields": [
        "event",
        "type",
        "collection_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "files_total",
        "files_uploaded",
        "bytes_total",
        "uploaded_bytes",
        "archive_storage_prefix",
        "archive_objects",
        "archive_total_bytes",
        "archive_store"
      ]
    },
    {
      "event": "collections.archive_retrying",
      "operator_urgency": "time_sensitive",
      "operator_action": "wait unless failures persist beyond normal connectivity trouble",
      "canonical_notification": {
        "actor": "riverhog",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Oink, archive finalizing hit a retryable issue: {error_80}. Next retry: {next_retry_at}; no action yet."
      },
      "required_payload_fields": [
        "event",
        "type",
        "collection_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "attempts",
        "failed_at",
        "next_retry_at",
        "retry_delay_seconds",
        "error"
      ]
    },
    {
      "event": "collections.archive_failed",
      "operator_urgency": "critical",
      "operator_action": "inspect Riverhog archive logs and collection upload state",
      "canonical_notification": {
        "actor": "riverhog",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Oink! Archiving stopped: {error_80}. Please inspect Riverhog; I will not retry this."
      },
      "required_payload_fields": [
        "event",
        "type",
        "collection_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "attempts",
        "failed_at",
        "error"
      ]
    }
  ]
}
