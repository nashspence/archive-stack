      "canonical_notification": {
        "actor": "riverhog",
        "title_template": "{emoji} {subject_40}",
        "body_template": "Oink, the archive is safe, but planner refresh failed. Please inspect Riverhog!"
      },
      "required_payload_fields": [
        "event",
        "type",
        "collection_id",
        "delivered_at",
        "operator_urgency",
        "operator_action",
        "files_total",
        "files_uploaded",
        "bytes_total",
        "uploaded_bytes"
      ],
      "optional_payload_fields": [
        "collection_url",
        "upload_url"
      ]
