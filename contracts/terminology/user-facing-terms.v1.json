{
  "schema_version": 1,
  "title": "Riverhog User-Facing Terminology",
  "purpose": "Inventory important terms currently exposed through Riverhog, Munchy, Jeb, API contracts, webhook payloads, and operator configuration. This contract records current vocabulary without embedding work-item state, review priority, ownership, or tracker links.",
  "term_type_values": {
    "entity": "A named resource, object, artifact, manifest, namespace, package, or material thing.",
    "activity": "An operator action, workflow, process, transition, or validation pass.",
    "state": "A condition, backlog, custody situation, readiness state, or coverage condition.",
    "policy": "A rule, setting, threshold, matcher, route, profile, or strategy that controls behavior.",
    "identifier": "A stable id, slug, label, selector, path-like reference, or other reference value.",
    "metadata_property": "A capture, provenance, creator, device, location, or time metadata field.",
    "enum_value": "A literal value exposed by configuration, API payloads, or machine contracts.",
    "software_agent": "An intentionally named Riverhog-family system, service, CLI, or agent."
  },
  "audience_values": [
    "operator",
    "config_author",
    "api_client",
    "webhook_recipient",
    "developer"
  ],
  "surface_values": [
    "cli:riverhog",
    "cli:munchy",
    "cli:jeb",
    "api:riverhog",
    "api:munchy-runner",
    "api:munchy-av1-nvenc",
    "webhook",
    "config:munchy",
    "config:jeb",
    "contract:openapi",
    "contract:webhooks",
    "docs",
    "service"
  ],
