<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.nashspence.riverhog.mount-marker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__AGENT_ROOT__/bin/mount-marker</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RIVERHOG_MOUNT_MARKER_NAME</key>
    <string>__MARKER_NAME__</string>
    <key>RIVERHOG_MOUNT_MARKER_TRIGGERS_DIR</key>
    <string>__TRIGGERS_DIR__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/mount-marker.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/mount-marker.err.log</string>
</dict>
</plist>
